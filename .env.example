# Melek Güzellik Salonu — sunucu ayarları
#
# Bu dosyayı `.env` adıyla kopyalayıp kendi değerlerinizi girin:
#     cp .env.example .env
#
# Sunucu açılışta `.env` dosyasını otomatik okur.
# `.env` dosyası .gitignore içindedir; depoya girmez.

# Yönetici paneli şifresi — MUTLAKA DEĞİŞTİRİN
MELEK_ADMIN_PASSWORD=buraya-guclu-bir-sifre-yazin

# Alternatif: şifreyi ayrı bir dosyadan oku.
# Şifrenizde $ " \ # veya boşluk varsa bu yöntemi kullanın —
# dosyanın içeriği ham şifredir, hiçbir kaçışlama gerekmez.
# MELEK_ADMIN_PASSWORD_FILE=/etc/melek-sifre

# Sunucunun dinleyeceği port
PORT=3000

# Veritabanı dosyasının yeri (varsayılan: data/melek.db)
# MELEK_DB=/var/lib/melek/melek.db

# HTTPS arkasında çalışıyorsanız 1 yapın (çerezler Secure işaretlenir)
# MELEK_SECURE_COOKIES=1

# Yönetici oturumunun kaç saat açık kalacağı (varsayılan 12)
# MELEK_SESSION_HOURS=12

# Ön yüz ayrı bir adreste barınıyorsa o adresi yazın
# MELEK_ALLOWED_ORIGIN=https://melekguzellik.com
